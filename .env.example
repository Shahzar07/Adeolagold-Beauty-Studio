# Adeolagold Beauty Studio — environment template.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
#
# Bank transfer works with none of these set: the studio account details live in
# src/lib/payments.ts and the checkout always offers "Bank transfer". Card,
# wallet and Klarna methods only appear once the matching merchant is connected.

# --- Stripe (card, Apple Pay, Google Pay, Klarna) ---------------------------
# Dashboard → Developers → API keys. The publishable key is safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only. Never prefix a secret with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=

# --- PayPal ----------------------------------------------------------------
# developer.paypal.com → Apps & Credentials → Live app.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata, sitemap and absolute URLs.
NEXT_PUBLIC_SITE_URL=https://adeolagoldbeautystudio.co.uk
